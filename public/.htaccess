# kensleyaesthetics.com — Next.js static export on cPanel / LiteSpeed
Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

RewriteEngine On
RewriteBase /

# Optional (recommended): one canonical origin — https + non-www.
# Delete this block if you ever put the site behind Cloudflare with "Flexible" SSL.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kensleyaesthetics.com%{REQUEST_URI} [R=301,L]

# 1) Real files (css / js / images / .html / .txt payloads) are served as-is.
#    Only -f here — the old "-d" pass-through let the folder hijack the route.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2) /treatments/  ->  treatments.html  (internal rewrite)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ $1.html [L]

# 3) /treatments  ->  treatments.html  (internal rewrite, URL stays clean)
#    Must run BEFORE any directory check: a folder with the same name exists.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Anything left is a bare folder (403 -> shows the 404 page) or a genuine 404.