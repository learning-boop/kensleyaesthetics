# kensleyaesthetics.com — Next.js static export on cPanel / LiteSpeed
Options -Indexes
# Don't redirect /route to /route/ just because a folder of the same name exists
# (folder/route collisions caused the old homepage copy and file listings).
DirectorySlash Off
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 410 /404.html

RewriteEngine On
RewriteBase /

# Optional (recommended): one canonical origin — https + non-www.
# Delete this block if you ever put the site behind Cloudflare with "Flexible" SSL.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kensleyaesthetics.com%{REQUEST_URI} [R=301,L]

# 0) Sub-treatment pages were removed (Nov 2026). Old copies may still sit on the
#    server because the deploy never deletes files, so answer 410 Gone (with the
#    site's 404 page) for /main-treatments/<treatment>/<sub-treatment> in any form.
#    Main treatment pages (/main-treatments/hifu) are not affected.
#
#    EXCEPTION (Nov 2026): Dermal Fillers has 10 live treatment pages again.
#    a) Old Dermal Fillers URLs 301 to their new address (keep in sync with
#       DERMAL_FILLERS_REDIRECTS in src/data/dermalFillersContent.js).
RewriteRule ^main-treatments/dermal-fillers/lips-1ml(\.html)?/?$ /main-treatments/dermal-fillers/lip-fillers [R=301,L]
RewriteRule ^main-treatments/dermal-fillers/cheeks(\.html)?/?$ /main-treatments/dermal-fillers/cheek-fillers [R=301,L]
RewriteRule ^main-treatments/dermal-fillers/chin(\.html)?/?$ /main-treatments/dermal-fillers/chin-fillers [R=301,L]
RewriteRule ^main-treatments/dermal-fillers/jawline(\.html)?/?$ /main-treatments/dermal-fillers/jawline-fillers [R=301,L]
RewriteRule ^main-treatments/dermal-fillers/nasolabial-folds(\.html)?/?$ /main-treatments/dermal-fillers/nasolabial-fold-fillers [R=301,L]
RewriteRule ^main-treatments/dermal-fillers/marionette-lines(\.html)?/?$ /main-treatments/dermal-fillers/marionette-line-fillers [R=301,L]
RewriteRule ^main-treatments/dermal-fillers/tear-trough(\.html)?/?$ /main-treatments/dermal-fillers/tear-trough-fillers [R=301,L]
RewriteRule ^main-treatments/dermal-fillers/temples(\.html)?/?$ /main-treatments/dermal-fillers/temple-fillers [R=301,L]
#    b) The live pages (and their .txt payloads) skip the 410 rule below.
#       Add a slug here whenever a Dermal Fillers page is added in Sanity.
RewriteCond %{REQUEST_URI} !^/main-treatments/dermal-fillers/(lip-fillers|cheek-fillers|chin-fillers|jawline-fillers|nasolabial-fold-fillers|marionette-line-fillers|facial-balancing|non-surgical-rhinoplasty|tear-trough-fillers|temple-fillers)(\.html|\.txt)?/?$
#    c) Anti-Wrinkle Consultations — 11 live consultation pages (Nov 2026).
RewriteCond %{REQUEST_URI} !^/main-treatments/anti-wrinkle-treatments/(frown-lines|forehead-lines|crows-feet|bunny-lines|gummy-smile|chin-dimpling|downturned-mouth-corners|masseter-jaw-muscles|neck-bands|underarm-sweating|trapezius-muscles)(\.html|\.txt)?/?$
#    d) Old anti-wrinkle slugs 301 to their new address.
RewriteRule ^main-treatments/anti-wrinkle-treatments/pebble-chin(\.html)?/?$ /main-treatments/anti-wrinkle-treatments/chin-dimpling [R=301,L]
RewriteRule ^main-treatments/anti-wrinkle-treatments/jawline-slimming(\.html)?/?$ /main-treatments/anti-wrinkle-treatments/masseter-jaw-muscles [R=301,L]
RewriteRule ^main-treatments/anti-wrinkle-treatments/nefertiti-lift(\.html)?/?$ /main-treatments/anti-wrinkle-treatments/neck-bands [R=301,L]
RewriteRule ^main-treatments/anti-wrinkle-treatments/traptox(\.html)?/?$ /main-treatments/anti-wrinkle-treatments/trapezius-muscles [R=301,L]
RewriteRule ^main-treatments/[^/]+/[^/]+ - [G,L]

# 0b) Only real location pages are public. Old town pages left on the server
#     (London, York, ...) answer 410 Gone. Add new live locations to this list.
RewriteCond %{REQUEST_URI} !^/locations/newcastle-upon-tyne(\.html|\.txt)?/?$
RewriteRule ^locations/.+ - [G,L]

# 1) Real files (css / js / images / .html / .txt payloads) are served as-is.
#    Only -f here — the old "-d" pass-through let the folder hijack the route.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2) /treatments/  ->  treatments.html  (internal rewrite)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ $1.html [L]

# 3) /treatments  ->  treatments.html  (internal rewrite, URL stays clean)
#    Must run BEFORE any directory check: a folder with the same name exists.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Anything left is a bare folder (403 -> shows the 404 page) or a genuine 404.